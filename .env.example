# Database — use Neon PostgreSQL connection string in production
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/millegusti

# JWT
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS — comma-separated list of allowed origins
# In production: https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173

# Upload directory (optional, defaults to ./uploads)
# UPLOAD_DIR=/tmp/uploads

# App
APP_NAME=MILLE GUSTI API
DEBUG=true
